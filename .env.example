# Database (Supabase: use the Session pooler connection string, port 5432)
DATABASE_URL=

# Auth (BETTER_AUTH_SECRET must be >= 32 chars, e.g. `openssl rand -base64 32`)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
NEXT_PUBLIC_BASE_URL=

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=

# Google GenAI
GOOGLE_API_KEY=

# Email (RESEND_API_KEY starts with re_)
RESEND_API_KEY=
# Example: Lumen Images <noreply@yourdomain.com>
EMAIL_FROM=
